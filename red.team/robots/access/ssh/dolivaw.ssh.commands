# configuration directives that give the server its instructions.[m[2;66H[K[3;1H[34m# See http://httpd.apache.org/docs/2.4/ for detailed information about[m[3;71H[K[4;1H[34m# the directives and /usr/share/doc/apache2/README.Debian about Debian specific
# hints.
#
#
# Summary of how the Apache 2 configuration works in Debian:
# The Apache 2 web server configuration in Debian is quite different to
# upstream's suggested way to configure the web server. This is because Debian's
# default Apache2 installation attempts to make adding and removing modules,
# virtual hosts, and extra configuration directives as flexible as possible, in
# order to make automating the changes and administering the server as easy as
# possible.

# It is split into several files forming the configuration hierarchy outlined
# below, all located in the /etc/apache2/ directory:
#
#       /etc/apache2/
#       |-- apache2.conf
#       |       `--  ports.conf
#       |-- mods-enabled
#       |       |-- *.load
#       |       `-- *.conf
#       |-- conf-enabled
#       |       `-- *.conf[m[27;87H1,1[11CTop[1;1H[?25h[?12$p[?25l[27;77HG[1;1H[27;77H [26;1H[27m[23m[29m[m[H[2J[1;1H[34m# requests.
#
# Note that the use of %{X-Forwarded-For}i instead of %h is not recommended.
# Use mod_remoteip instead.
#[m
[36mLogFormat[m [31m"%v:%p %h %l %u %t \"%r\" %>s %O \"%{Referer}i\" \"%{User-Agent}i\""[m vhost_combined
[36mLogFormat[m [31m"%h %l %u %t \"%r\" %>s %O \"%{Referer}i\" \"%{User-Agent}i\""[m combined
[36mLogFormat[m [31m"%h %l %u %t \"%r\" %>s %O"[m common
[36mLogFormat[m [31m"%{Referer}i -> %U"[m [31mreferer[m
[36mLogFormat[m [31m"%{User-agent}i"[m agent

[34m# Include of directories ignores editors' and dpkg's backup files,
# see README.Debian for details.

# Include generic snippets of statements[m
IncludeOptional conf-enabled/*.conf

[34m# Include the virtual host configurations:[m
IncludeOptional sites-enabled/*.conf

[34m# vim: syntax=apache ts=4 sw=4 sts=4 sr noet[m
APACHE_RUN_DIR=/var/run/apache2
APACHE_RUN_USER=www-data
