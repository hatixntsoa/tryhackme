import base64, glob
from Crypto.Cipher import AES   # if missing: pip install pycryptodome --break-system-packages
key = base64.b64decode('fXFKcmfoirwa/SI4MMt018hA9nf/Fl++ycE0WV8G+qg=')
for f in ['/tmp/cache.dat'] + glob.glob('/tmp/out/*review-cache*'):
    b = open(f,'rb').read()
    print(f, len(b))
    for n in (len(b), len(b.rstrip(b'\x00'))):
        ct = b[16:n]
        ct = ct[:len(ct)//16*16]
        pt = AES.new(key, AES.MODE_CBC, b[:16]).decrypt(ct)
        print("  trim", n, "starts:", pt[:4], pt[:16].hex())
        if pt[:2] == b'PK':
            open('/tmp/review-cache.zip','wb').write(pt)
            print("  -> wrote /tmp/review-cache.zip")
EOF
