import struct
d = open('/tmp/cover.png','rb').read()
print("total size:", len(d), "magic ok:", d[:8]==b'\x89PNG\r\n\x1a\n')
p = 8
while p+8 <= len(d):
    ln, typ = struct.unpack('>I4s', d[p:p+8])
    print(hex(p), typ, ln)
    p += 12 + ln
    if typ == b'IEND': break
print("trailing bytes after IEND:", len(d)-p)
print(d[p:p+64].hex())
EOF
