import struct, os
from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
from cryptography.hazmat.primitives.ciphers.aead import AESGCM

M = (1 << 64) - 1
def splitmix_key(seed):
    s = seed
    out = b""
    for _ in range(4):
        s = (s + 0x9e3779b97f4a7c15) & M
        z = s
        z = ((z ^ (z >> 30)) * 0xbf58476d1ce4e5b9) & M
        z = ((z ^ (z >> 27)) * 0x94d049bb133111eb) & M
        z = z ^ (z >> 31)
        out += struct.pack("<Q", z)
    return out

def parse(path):
    d = open(path, "rb").read()
    assert d[:4] == b"GPH1"
[7m    return d[:0x1c], d[0x10:0x1c], d[0x1c:0x2c], d[0x30:][27m

[7maad, nonce, tag, ct = parse("yard_0147.jpg.locked")[27m

[7m# fast pre-check: first keystream block (GCM counter starts at 2) must give JPEG magic[27m
[7mctr_iv = nonce + (2).to_bytes(4, "big")[27m
[7mfound = None[27m
[7mfor seed in range(1792474614000, 1792474640000):[27m
[7m    key = splitmix_key(seed)[27m[7m    ks = Cipher(algorithms.AES(key), modes.CTR(ctr_iv)).decryptor().update(ct[:16])[27m[7m    if ks[:3] == b"\xff\xd8\xff":[27m[7m        try:[27m[7m            AESGCM(key).decrypt(nonce, ct + tag, aad)   # full tag verification[27m[7m            found = seed[27m[7m            break[27m[7m        except Exception:[27m[7m            pass[27m[7mprint("SEED =", found)[27m[7mif found:[27m[7m    key = splitmix_key(found)[27m[7m    print("KEY  =", key.hex())[27m[7m    os.makedirs("out", exist_ok=True)[27m[7m    for n in ("yard_0147.jpg", "yard_0148.jpg", "yard_0152.jpg"):[27m[7m        aad, nonce, tag, ct = parse(n + ".locked")[27m[7m        pt = AESGCM(key).decrypt(nonce, ct + tag, aad)[27m[7m        open("out/" + n, "wb").write(pt)[27m[7m        print("decrypted", n, len(pt))[27m[7mEOF[27m[A[A[A[A[A[A[A[A    return d[:0x1c], d[0x10:0x1c], d[0x1c:0x2c], d[0x30:]

aad, nonce, tag, ct = parse("yard_0147.jpg.locked")

# fast pre-check: first keystream block (GCM counter starts at 2) must give JPEG magic
ctr_iv = nonce + (2).to_bytes(4, "big")
