Description=Meridian image library
After=network.target
[Service]
Type=simple
User=gallery
Group=gallery
WorkingDirectory=/srv/gallery/app
EnvironmentFile=/etc/gallery/gallery.env
ExecStart=/usr/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8080 --access-logfile - --error-logfile - gallery:app
Restart=on-failure
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/gallery
MemoryMax=384M
[Install]
WantedBy=multi-user.target
